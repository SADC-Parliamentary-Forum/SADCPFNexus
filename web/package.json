{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "verify:build-context": "node scripts/verify-build-context.js",
    "postinstall": "node scripts/vendor-pdf.js",
    "prebuild": "npm run verify:build-context && node scripts/vendor-pdf.js",
    "dev": "next dev --webpack --hostname 0.0.0.0",
    "dev:turbopack": "next dev --turbopack",
    "dev:webpack": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:report": "playwright show-report playwright-report",
    "test:auth": "playwright test --project=auth",
    "test:staff": "playwright test --project=staff",
    "test:admin": "playwright test --project=admin",
    "verify:redirect": "node --experimental-strip-types scripts/verify-safe-internal-path.mts",
    "verify:mfa": "node --experimental-strip-types scripts/verify-privileged-mfa.mts",
    "verify:travel-attachments": "node scripts/verify-travel-attachment-multipart.mjs",
    "test:unit": "node --experimental-strip-types --test lib/**/*.test.mts",
    "test:a11y": "playwright test tests/e2e/a11y.spec.ts --project=staff",
    "test:smokes:sa-proc": "playwright test tests/e2e/sa-procurement-smokes.spec.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.21",
    "axios": "^1.13.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.575.0",
    "next": "^16.2.3",
    "next-auth": "^5.0.0-beta.30",
    "react": "19.2.5",
    "react-dom": "19.2.3",
    "react-qr-code": "^2.0.18",
    "signature_pad": "^5.1.3",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "dompurify": ">=3.4.0",
    "follow-redirects": ">=1.16.0",
    "postcss": ">=8.5.10"
  }
}
