APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email â€” set MAIL_MAILER=smtp for production and configure SMTP credentials below.
# With MAIL_MAILER=log all emails are written to storage/logs/laravel.log (dev/testing).
# The queue worker (sadcpf_queue container) must be running for emails to be dispatched.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=notifications@sadcpf.org
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notifications@sadcpf.org"
MAIL_FROM_NAME="SADC-PF Nexus"

# Frontend URL embedded in welcome emails and alert digests
APP_FRONTEND_URL=https://nexus.sadcpf.org

SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8000

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# CORS: allowed origin when frontend uses credentials (Next.js, Flutter web, etc.).
# Set to your frontend origin (e.g. http://localhost:3000). After changing this or config/cors.php, run: php artisan config:clear
FRONTEND_URL=http://localhost:3000

VITE_APP_NAME="${APP_NAME}"

# â”€â”€â”€ Salary Advance payroll recovery adapter â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# manual (default) | null | disabled | vendor
# vendor requires SALARY_ADVANCE_PAYROLL_VENDOR_CLASS implementing
# App\Modules\Finance\Contracts\PayrollRecoveryAdapterInterface
# Do NOT put third-party payroll API secrets here.
SALARY_ADVANCE_PAYROLL_DRIVER=manual
# SALARY_ADVANCE_PAYROLL_VENDOR_CLASS=

# â”€â”€â”€ Firebase Cloud Messaging (push notifications) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Generate a Firebase project at https://console.firebase.google.com
# Run `flutterfire configure` in /mobile to generate firebase_options.dart
# Download the service account JSON from Project Settings â†’ Service Accounts
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=   # optional: path to service-account.json
FCM_CLIENT_EMAIL=            # from service account JSON
FCM_PRIVATE_KEY=             # from service account JSON (newlines as \n)

# --- Correspondence registry IMAP (suggestions only; never auto-register) ---
# Designated registry mailbox ONLY — do not point at an all-employee inbox.
# Operator setup:
#   1) Enable mailbox in Admin → Correspondence mailbox settings (host, port, encryption, username).
#   2) Set CORRESPONDENCE_IMAP_PASSWORD here (preferred) or encrypted DB fallback in UI.
#   3) PHP ext-imap must be present in the API image (docker/php/Dockerfile installs it).
# Live poll: settings.enabled + host/username + password + ext-imap.
# Without credentials or ext-imap, `php artisan correspondence:poll-mailbox` degrades gracefully
# (use --fixture for tests). Poll never auto-submits official correspondence.
CORRESPONDENCE_IMAP_PASSWORD=
CORRESPONDENCE_IMAP_TIMEOUT=30

# Optional courier tracking HTTP base (carrier status poll). Empty = local stub progression.
# CORRESPONDENCE_COURIER_TRACKING_URL=

# --- Fleet vendor telematics (pluggable; default disabled = manual GPS stub) ---
# Drivers: null|disabled|generic_http|http_webhook
# generic_http polls FLEET_TELEMATICS_BASE_URL for JSON:
#   { "positions": [ { "device_id", "lat", "lng", "recorded_at" } ] }
# http_webhook enables push intake at POST /api/v1/fleet/telematics/webhook
# Leave keys empty until a real vendor is configured — never commit secrets.
FLEET_TELEMATICS_DRIVER=null
# FLEET_TELEMATICS_BASE_URL=
# FLEET_TELEMATICS_API_KEY=
# FLEET_TELEMATICS_WEBHOOK_TOKEN=
# FLEET_TELEMATICS_SCHEDULE_ENABLED=false
# FLEET_TELEMATICS_HTTP_TIMEOUT=20

# --- Weekly report AI draft (human confirm only; never auto-submit) ---
# stub (default) | llm (requires endpoint + key; still falls back to stub narrative)
WEEKLY_AI_PROVIDER=stub
# WEEKLY_AI_LLM_ENDPOINT=
# WEEKLY_AI_LLM_API_KEY=

# --- Procurement AI comparison (assistive only; never auto-award) ---
PROCUREMENT_AI_COMPARISON_ENABLED=false
PROCUREMENT_AI_COMPARISON_PROVIDER=stub
# PROCUREMENT_AI_COMPARISON_LLM_ENDPOINT=
# PROCUREMENT_AI_COMPARISON_LLM_API_KEY=

# --- M&E AI assist (human confirm only; never auto-submit activity reports) ---
MANDE_AI_PROVIDER=stub
# MANDE_AI_LLM_ENDPOINT=
# MANDE_AI_LLM_API_KEY=

# --- Vendor payroll payslip import (staging only; no OT rate invention) ---
# null = accept uploaded structured JSON | generic_http = optional remote pull + upload fallback
PAYROLL_VENDOR_DRIVER=null
# PAYROLL_VENDOR_HTTP_URL=
# PAYROLL_VENDOR_API_KEY=
# PAYROLL_VENDOR_HTTP_TIMEOUT=20

# --- External calendar (ICS round-trip is default; Google two-way when credentials exist) ---
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_REDIRECT_URI=
# GOOGLE_CALENDAR_REFRESH_TOKEN=
# Path to service-account JSON on the server (alternative to refresh token):
# GOOGLE_CALENDAR_SERVICE_ACCOUNT_JSON=
# GOOGLE_CALENDAR_ID=primary
# Shared secret for Google push notifications → POST /api/v1/assignments/google-calendar/webhook
# GOOGLE_CALENDAR_WEBHOOK_SECRET=

# --- People & Authority Phase 2/3 integrations (env-only secrets; stub/null defaults) ---
# Certificate signatures: stub (default) | pkcs11_http
PEOPLE_AUTHORITY_CERTIFICATE_DRIVER=stub
# PEOPLE_AUTHORITY_CERTIFICATE_HTTP_URL=
# PEOPLE_AUTHORITY_CERTIFICATE_HTTP_TOKEN=

# External e-sign: null (default) | generic_http — human-triggered submit only
PEOPLE_AUTHORITY_ESIGN_DRIVER=null
# PEOPLE_AUTHORITY_ESIGN_HTTP_URL=
# PEOPLE_AUTHORITY_ESIGN_HTTP_TOKEN=
# PEOPLE_AUTHORITY_ESIGN_HTTP_TIMEOUT=20

# Microsoft 365 / directory sync (read-only): null | fixture | microsoft_graph
PEOPLE_AUTHORITY_M365_DRIVER=null
# PEOPLE_AUTHORITY_M365_TENANT_ID=
# PEOPLE_AUTHORITY_M365_CLIENT_ID=
# PEOPLE_AUTHORITY_M365_CLIENT_SECRET=
# PEOPLE_AUTHORITY_M365_FIXTURE_PATH=
PEOPLE_AUTHORITY_M365_DRY_RUN=true

# Automated role recertification schedule (opens campaigns only; never auto-decides)
PEOPLE_AUTHORITY_RECERT_SCHEDULE_ENABLED=false

# People AI assist — stub default; never auto-grants access/authority/delegation/signing/roles
PEOPLE_AUTHORITY_AI_PROVIDER=stub
PEOPLE_AUTHORITY_AI_ENABLED=true
# PEOPLE_AUTHORITY_AI_HTTP_URL=
# PEOPLE_AUTHORITY_AI_HTTP_TOKEN=

# Mobile store release tooling (status only in Admin settings)
# PLAY_STORE_SERVICE_ACCOUNT_JSON=
# ASC_KEY_ID=
# ASC_ISSUER_ID=
# ASC_PRIVATE_KEY_PATH=

