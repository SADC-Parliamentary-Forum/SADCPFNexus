APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Email — set MAIL_MAILER=smtp for production and configure SMTP credentials below.
# With MAIL_MAILER=log all emails are written to storage/logs/laravel.log (dev/testing).
# The queue worker (sadcpf_queue container) must be running for emails to be dispatched.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=notifications@sadcpf.org
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="notifications@sadcpf.org"
MAIL_FROM_NAME="SADC-PF Nexus"

# Frontend URL embedded in welcome emails and alert digests
APP_FRONTEND_URL=https://nexus.sadcpf.org

SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:8000

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# CORS: allowed origin when frontend uses credentials (Next.js, Flutter web, etc.).
# Set to your frontend origin (e.g. http://localhost:3000). After changing this or config/cors.php, run: php artisan config:clear
FRONTEND_URL=http://localhost:3000

VITE_APP_NAME="${APP_NAME}"

# ─── Salary Advance payroll recovery adapter ──────────────────────────────────
# manual (default) | null | disabled | vendor
# vendor requires SALARY_ADVANCE_PAYROLL_VENDOR_CLASS implementing
# App\Modules\Finance\Contracts\PayrollRecoveryAdapterInterface
# Do NOT put third-party payroll API secrets here.
SALARY_ADVANCE_PAYROLL_DRIVER=manual
# SALARY_ADVANCE_PAYROLL_VENDOR_CLASS=

# ─── Firebase Cloud Messaging (push notifications) ────────────────────────────
# Generate a Firebase project at https://console.firebase.google.com
# Run `flutterfire configure` in /mobile to generate firebase_options.dart
# Download the service account JSON from Project Settings → Service Accounts
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_JSON=   # optional: path to service-account.json
FCM_CLIENT_EMAIL=            # from service account JSON
FCM_PRIVATE_KEY=             # from service account JSON (newlines as \n)

# --- Correspondence registry IMAP (suggestions only; never auto-register) ---
# Designated registry mailbox ONLY � do not point at an all-employee inbox.
# Live poll runs when settings.enabled + host/username + password + PHP ext-imap.
# Without credentials or ext-imap, correspondence:poll-mailbox degrades gracefully.
# CORRESPONDENCE_IMAP_PASSWORD=
# CORRESPONDENCE_IMAP_TIMEOUT=30

# Correspondence � designated registry mailbox IMAP (suggestions only; never all-employee ingest).
# Prefer env password; UI may store an encrypted DB fallback. Requires PHP ext-imap for live poll.
# Without credentials or ext-imap, `php artisan correspondence:poll-mailbox` degrades gracefully
# (use --fixture for tests). Poll never auto-submits official correspondence.
CORRESPONDENCE_IMAP_PASSWORD=
CORRESPONDENCE_IMAP_TIMEOUT=30

# --- Fleet vendor telematics (pluggable; default disabled = manual GPS stub) ---
# Drivers: null|disabled|generic_http|http_webhook
# generic_http polls FLEET_TELEMATICS_BASE_URL for JSON:
#   { "positions": [ { "device_id", "lat", "lng", "recorded_at" } ] }
# http_webhook enables push intake at POST /api/v1/fleet/telematics/webhook
# Secrets stay in env � never hardcode vendor API keys.
FLEET_TELEMATICS_DRIVER=null
# FLEET_TELEMATICS_BASE_URL=
# FLEET_TELEMATICS_API_KEY=
# FLEET_TELEMATICS_WEBHOOK_TOKEN=
# FLEET_TELEMATICS_SCHEDULE_ENABLED=false
# FLEET_TELEMATICS_HTTP_TIMEOUT=20
