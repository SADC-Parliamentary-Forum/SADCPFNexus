APP_NAME="SADCPFNexus"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:<generate-with-php-artisan-key-generate>
APP_URL=https://api.yourdomain.com

FRONTEND_URL=https://app.yourdomain.com

# Logging — use warning or error in production (not debug)
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Database — use production credentials
DB_CONNECTION=pgsql
DB_HOST=<production-db-host>
DB_PORT=5432
DB_DATABASE=sadcpfnexus
DB_USERNAME=sadcpf
DB_PASSWORD=<strong-random-password>

# Redis (recommended for queue, cache, sessions in production)
# CACHE_STORE=redis
# SESSION_DRIVER=redis
# QUEUE_CONNECTION=redis
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379

# Session — encrypt and secure in production
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

# Sanctum token auth
# SANCTUM_EXPIRATION: token lifetime in minutes (1440 = 24h, 480 = 8h)
SANCTUM_EXPIRATION=1440
SANCTUM_STATEFUL_DOMAINS=app.yourdomain.com
SANCTUM_TOKEN_PREFIX=sadcpf_

# Password hashing
BCRYPT_ROUNDS=12

# File storage (use S3 or similar in production)
FILESYSTEM_DISK=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=
# AWS_BUCKET=

# Mail
MAIL_MAILER=smtp
MAIL_HOST=<smtp-host>
MAIL_PORT=587
MAIL_USERNAME=<smtp-user>
MAIL_PASSWORD=<smtp-password>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_FROM_NAME="SADCPFNexus"

# Privileged roles must enable MFA (default true when APP_ENV=production)
REQUIRE_PRIVILEGED_MFA=true

# Machine token for GET /api/v1/external/workplan (X-External-Token)
EXTERNAL_WORKPLAN_TOKEN=<generate-long-random-secret>

# Optional Sentry — leave empty until org/project exists; never commit a real DSN.
# Lightweight wiring reads SENTRY_LARAVEL_DSN (fallback SENTRY_DSN). Install
# sentry/sentry-laravel only when you are ready to forward exceptions.
# SENTRY_LARAVEL_DSN=
# SENTRY_DSN=

# ---------------------------------------------------------------------------
# SEEDING (CRITICAL)
# ---------------------------------------------------------------------------
# Production structural seed only:
#   php artisan db:seed --class=ProductionSeeder
#   php artisan app:create-admin
#
# NEVER run DemoDataSeeder, DatabaseSeeder (full), or migrate:fresh --seed in
# production. Those load demo users and fake module data.
# Deploy script reseeds RolesAndPermissionsSeeder + WorkflowSeeder only.

# --- Correspondence registry IMAP (suggestions only; never auto-register) ---
# Designated registry mailbox ONLY � never all-employee ingest / AI auto-submit.
# Requires PHP ext-imap in the API image. Missing credentials/extension => degraded status.
# CORRESPONDENCE_IMAP_PASSWORD=<registry-mailbox-app-password>
# CORRESPONDENCE_IMAP_TIMEOUT=30

# Correspondence registry IMAP (designated mailbox only � suggestions, not auto-submit)
# Requires PHP ext-imap. Leave blank to disable live poll; fixture/dry-run still work in non-prod.
CORRESPONDENCE_IMAP_PASSWORD=
CORRESPONDENCE_IMAP_TIMEOUT=30
