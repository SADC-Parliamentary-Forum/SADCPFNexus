{
  "permissions": {
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.production)",
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./**/key.properties)",
      "Read(./**/*.p12)",
      "Read(./**/*.pem)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(* > /dev/sd*)"
    ],
    "ask": [
      "Bash(ssh *)",
      "Bash(scp *)"
    ]
  },
  "enabledPlugins": {
    "ecc@ecc": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-env-writes.js\"",
            "timeout": 10,
            "statusMessage": "Checking env-file guardrail"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-secret-scan.js\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
